{
  "manifest_version": 3,
  "name": "Cookie Eater",
  "version": "0.1.1",
  "description": "Reject cookies when possible. Accept when needed to continue. All on your Mac.",
  "permissions": [
    "storage",
    "nativeMessaging",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "engine.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Eater",
    "default_icon": {
      "32": "icon.png",
      "64": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png",
    "256": "icon.png",
    "512": "icon.png"
  }
}
